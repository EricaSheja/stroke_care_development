# Owner: Orion Kabeza (DevOps)
# Copy to ".env" on each server and fill it in. Never commit the real .env. The secrets must be identical on web-01
# and web-02. Make them long and random:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DOMAIN=strokecare.orion-labs.dev
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# 1 only for the course demo with fictional data.
ALLOW_DEMO_DATA=1
# This server's private address (run: hostname -I).
BIND_IP=
# web-01: DB_HOST=db.   web-02: the private address of web-01.
DB_HOST=db
# lb-01 only: the private addresses of the two app servers.
WEB1=
WEB2=
